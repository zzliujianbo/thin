# Thin 专用 OpenSSH 入口：样例，未安装、未启用。
#
# 用途：为 Thin 提供独立 SSH 登录入口。登录后只运行 `thin --connect`，不提供 shell、
# sftp/scp、远程命令、端口转发或 agent 转发。认证仍由 OpenSSH + 系统 PAM/OS 账户完成；
# Thin 不读取 /etc/shadow，不保存登录密码，也不再维护第二套账户密码。
#
# 必须作为**独立实例**运行，不要 Include 进管理用的 /etc/ssh/sshd_config，
# 不要修改或覆盖管理端口 22 的现有配置：
#   /usr/sbin/sshd -D -f /etc/ssh/sshd_config.thin
#
# 校验语法（只解析，不启动）：sshd -t -f /etc/ssh/sshd_config.thin
#
# 标有 THIN:REPLACE 的行必须由部署者按本机情况修改后才能使用。
# 语法注释只能整行，OpenSSH 不支持行尾注释。

# THIN:REPLACE 端口：必须是未占用的专用端口，不能等于管理端口 22，也不能与其它服务冲突。
Port 2222

# THIN:REPLACE 允许登录的 OS 账户（必须替换为你自己的账户名）。
# 该账户须已存在、有可用的登录 shell、并由系统管理员批准的认证方式。
AllowUsers thinuser

# 认证交给系统账户与 PAM；不放开空密码，不放开 root。
UsePAM yes
PasswordAuthentication yes
PermitEmptyPasswords no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxAuthTries 3
LoginGraceTime 30

# 必须有 PTY；无 PTY 的请求不降级成 shell 或一次性模式。
PermitTTY yes

# THIN:REPLACE 最后一段必须保留 `thin --connect`。
# ForceCommand 由 sshd 用登录 shell 执行，因此这里是管理员固定的字符串，
# 不接受客户端自带的命令；`--connect` 不会自动启动守护服务。
# 该账户的登录 shell 必须是可用 shell（nologin / false 会导致登录失败）。
ForceCommand /usr/local/bin/thin --connect

# 不执行用户 rc 与环境文件，避免绕过强制命令。
PermitUserRC no
PermitUserEnvironment no

# 关闭全部转发与隧道（DisableForwarding 覆盖 agent/X11/TCP/streamlocal）。
DisableForwarding yes
AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no

# 单连接单会话。
MaxSessions 1

# 独立 PidFile，避免与管理系统 sshd 的 /run/sshd.pid 冲突。
PidFile /run/sshd-thin.pid

# 使用系统已有的稳定主机密钥，不在每次启动时重新生成，避免客户端指纹反复告警。
HostKey /etc/ssh/ssh_host_ed25519_key

# 不声明 Subsystem：本入口不提供 sftp。

# 连接空闲检测：客户端静默失联时由 sshd 关闭会话；
# Thin 侧的会话所有权由用户守护服务持有，SSH 断开不等于取消任务。
ClientAliveInterval 300
ClientAliveCountMax 2

LogLevel INFO
